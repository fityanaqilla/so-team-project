# env.example — salin menjadi .env (chmod 0600), atau jalankan: ./deploy.sh --init-env
# JANGAN commit .env ke Git. Gunakan tanda kutip ganda untuk nilai dengan karakter khusus.

# --- Aplikasi / Nginx ---
APP_PORT=8000
DOMAIN_NAME=_

# --- Database (tier 3, hanya loopback) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webapp_db
DB_USER=webapp_user
DB_PASS="CHANGE_ME_use_a_long_random_password"

# --- Keamanan ---
ENABLE_FIREWALL=true
SSH_PORT=22
